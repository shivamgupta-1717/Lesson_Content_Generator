# =====================================================================
# SELF-EVALUATING LESSON CONTENT GENERATOR - ENVIRONMENT CONFIGURATION
# =====================================================================
# Copy this file to .env and configure your desired LLM provider.
#
# Supported Providers:
#   - mock       : Zero-API-key deterministic simulation mode (ideal for offline tests & fast local evaluation)
#   - openai     : OpenAI API (e.g., gpt-4o, gpt-4o-mini)
#   - gemini     : Google Gemini API (e.g., gemini-1.5-pro, gemini-1.5-flash)
#   - groq       : Groq Cloud API (e.g., llama-3.3-70b-versatile)
#   - anthropic  : Anthropic Claude (e.g., claude-3-5-sonnet)
#   - ollama     : Local Ollama server (OpenAI-compatible)
# =====================================================================

# Active Provider Selection (mock | openai | gemini | groq | anthropic | ollama)
LLM_PROVIDER=mock

# Model Name to use for the selected provider
# OpenAI defaults: gpt-4o-mini, gpt-4o
# Gemini defaults: gemini-1.5-flash, gemini-1.5-pro
# Groq defaults: llama-3.3-70b-versatile
# Ollama defaults: llama3.1
LLM_MODEL=gpt-4o-mini

# Model Temperature (0.0 to 1.0) - Lower for more deterministic evaluation and structured output
LLM_TEMPERATURE=0.3

# Request Timeout in seconds
LLM_TIMEOUT=60

# Provider API Keys (leave empty or unset if using 'mock' or local 'ollama')
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

ANTHROPIC_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434/v1

# Workflow Configuration
MAX_REGENERATION_RETRIES=2

# Persistent Database File Path
DATABASE_PATH=data/lesson_generator.db

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
